{
  "tesserae_compat": "1.x",
  "name": "Family Dashboard",
  "version": "1.1.0",
  "kind": "widget",
  "description": "Full-screen family dashboard with date, weather forecast, and Google Calendar agenda.",
  "icon": "ph-calendar-check",
  "supports": {
    "sizes": [
      "md",
      "lg"
    ]
  },
  "cell_options": [ 
    {
      "name": "google_credentials_json",
      "type": "textarea",
      "label": "Service Account JSON (paste file contents or file path)",
      "default": "",
      "mask": true
    },
    {
      "name": "calendar_ids",
      "type": "string",
      "label": "Calendar IDs (comma-separated)",
      "default": "primary"
    },
    {
      "name": "ics_url",
      "type": "string",
      "label": "Fallback iCal (.ics) URL (used if Google API credentials are blank)",
      "default": "",
      "mask": false
    },
    {
      "name": "color_icon_map",
      "type": "textarea",
      "label": "Color ID to Icon Mapping (one per line: ID=icon-name)",
      "default": "1=ph-backpack\n2=ph-first-aid\n3=ph-trophy\n4=ph-cake\n5=ph-fork-knife\n6=ph-car\n7=ph-barbell\n8=ph-briefcase\n9=ph-books\n10=ph-leaf\n11=ph-warning"
    },
    {
      "name": "days_ahead",
      "type": "number",
      "label": "Days to show in agenda",
      "default": 5
    },
    {
      "name": "latitude",
      "type": "number",
      "label": "Latitude (leave blank for device home)",
      "default": null
    },
    {
      "name": "longitude",
      "type": "number",
      "label": "Longitude (leave blank for device home)",
      "default": null
    },
    {
      "name": "units",
      "type": "select",
      "label": "Temperature units",
      "default": "fahrenheit",
      "choices": [
        {
          "value": "fahrenheit",
          "label": "Fahrenheit (\u00b0F)"
        },
        {
          "value": "celsius",
          "label": "Celsius (\u00b0C)"
        }
      ]
    },
    {
      "name": "time_format",
      "type": "select",
      "label": "Time format",
      "default": "12h",
      "choices": [
        {
          "value": "12h",
          "label": "12-hour (AM/PM)"
        },
        {
          "value": "24h",
          "label": "24-hour"
        }
      ]
    }
  ],
  "requires": [
    "network:api.open-meteo.com",
    "network:www.googleapis.com",
    "network:*",
    "settings:app"
  ],
  "render": {
    "needs_network": true
  },
  "data_schema": {
    "fields": [
      {
        "name": "value",
        "label": "Value",
        "type": "num"
      }
    ],
    "sample": {
      "value": 1
    }
  }
}
